# Used by docker-compose.yml. Copy to `.env` and fill in real values before
# running `docker compose up` anywhere other than a throwaway local test.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookreader

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# The public origin end users hit (through nginx). Used for CORS and for
# building absolute upload URLs. Must match EXACTLY what the browser sends as
# its Origin header, including a non-standard port if you're using one (e.g.
# http://localhost:8090) — a mismatch (even just a missing port) makes the
# backend's CORS check reject the request with 403 on every POST/PUT/DELETE.
PUBLIC_ORIGIN=http://localhost

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=Strict

RATE_LIMIT_RPM=120

# --- Optional: S3-compatible storage instead of local disk ---
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
