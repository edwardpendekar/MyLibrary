# Used by docker-compose.yml. Copy to `.env` and fill in real values before
# running `docker compose up` anywhere other than a throwaway local test.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookreader

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# The public origin end users hit (through nginx). Used for CORS and for
# building absolute upload URLs. Must match EXACTLY what the browser sends as
# its Origin header, including a non-standard port if you're using one (e.g.
# http://localhost:8090) — a mismatch (even just a missing port) makes the
# backend's CORS check reject the request with 403 on every POST/PUT/DELETE.
PUBLIC_ORIGIN=http://localhost

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=Strict

RATE_LIMIT_RPM=120
RATE_LIMIT_AUTH_RPM=10

# --- Optional: S3-compatible storage instead of local disk ---
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Base URL of the frontend, used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:3000

# --- Optional: SMTP for transactional email (password reset). When SMTP_HOST
# is left empty, the backend logs the reset link instead of emailing it —
# fine for local dev, but MUST be set in any real deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bookreader.local

# --- Optional: Gemini API key for the admin "translate a book from an
# uploaded document" feature (Admin > Import > Translate from Document). Get
# a free-tier key at https://aistudio.google.com/apikey. Left empty, that
# feature responds with a clear "not configured" error; everything else works
# without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
