# Copy to .env for local development. In Docker/production these are injected
# as real environment variables instead (see docker-compose.yml).

APP_ENV=development
PORT=8080
LOG_LEVEL=info

# --- PostgreSQL ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bookreader?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT / sessions ---
# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=bookreader-api
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=Strict

# --- Storage: local | s3 ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_LOCAL_PUBLIC_URL=http://localhost:8080/uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true
S3_PUBLIC_URL=

# --- CORS / rate limiting ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_RPM=120
RATE_LIMIT_AUTH_RPM=10

# --- Password reset email ---
FRONTEND_URL=http://localhost:3000
# Leave SMTP_HOST empty to log reset links to the console instead of emailing them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bookreader.local

# --- Admin "translate a book from a document" feature (Gemini API) ---
# Free-tier key at https://aistudio.google.com/apikey. Leave empty to disable
# the feature (it returns a clear "not configured" error) without affecting
# anything else.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_REQUEST_DELAY, PYTHON_BIN, TRANSLATE_SCRIPT_PATH, and
# TRANSLATE_COMMAND_TIMEOUT all have sane defaults and rarely need overriding.
